# ============================================================
# 合同审批审查系统 — 环境变量模板
# ============================================================
# 复制为 .env 后按需修改。.env 不进 Git。
# ============================================================

# ---------- 基础设施 · MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=contract_review
MYSQL_USER=contract_review
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

# ---------- 基础设施 · Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_DB=0
REDIS_PASSWORD=

# ---------- 基础设施 · MinIO ----------
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_ENDPOINT=127.0.0.1:19000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_SECURE=false
MINIO_BUCKET_CONTRACTS=contracts
MINIO_BUCKET_REPORTS=reports

# ---------- LLM Provider ----------
# mock | openai_compat
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3

# ---------- 应用 ----------
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# ---------- 宿主能力 ----------
# WPS COM 需要交互式桌面会话，不能跑成服务
DOCX_CONVERTER=wps_com
WPS_COM_TIMEOUT=60

# ---------- 解析参数 ----------
# 解析一律走进程内库调用（PyMuPDF / python-docx / RapidOCR），
# 因此没有"解析服务地址"这类配置项；PDF 解析能力由 PyMuPDF 提供。
OCR_DPI=200
OCR_ENGINE=rapidocr
PARSE_BASE_TIMEOUT=60
PARSE_PER_PAGE_TIMEOUT=30

# ---------- mock 审批服务 ----------
MOCK_APPROVAL_HOST=127.0.0.1
MOCK_APPROVAL_PORT=8010
